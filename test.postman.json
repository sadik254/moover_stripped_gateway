{
  "info": {
    "name": "Moover Stripped Gateway API",
    "description": "Current API routes. Set {{token}} to a token for the role required by each request. The login requests automatically update it when successful.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "booking_id", "value": "1", "type": "string" },
    { "key": "vehicle_class_id", "value": "1", "type": "string" },
    { "key": "vehicle_id", "value": "1", "type": "string" },
    { "key": "driver_id", "value": "1", "type": "string" },
    { "key": "customer_id", "value": "1", "type": "string" },
    { "key": "affiliate_id", "value": "1", "type": "string" },
    { "key": "affiliate_driver_id", "value": "1", "type": "string" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "User Authentication",
      "item": [
        { "name": "Login User", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}" }, "url": "{{base_url}}/user/login" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code < 400 && pm.response.json().token) { pm.collectionVariables.set('token', pm.response.json().token); }"] } }] },
        { "name": "Current User", "request": { "method": "GET", "url": "{{base_url}}/user" } },
        { "name": "Update User", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Admin\"\n}" }, "url": "{{base_url}}/user/update" } },
        { "name": "Create Dispatcher", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Dispatcher\",\n  \"email\": \"dispatcher@example.com\"\n}" }, "url": "{{base_url}}/user/create-dispatcher" } },
        { "name": "Update User Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword123\",\n  \"new_password_confirmation\": \"newpassword123\"\n}" }, "url": "{{base_url}}/user/update-password" } },
        { "name": "Logout User", "request": { "method": "POST", "url": "{{base_url}}/user/logout" } }
      ]
    },
    {
      "name": "Company And Configuration",
      "item": [
        { "name": "Create Company", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Moover Test Transport\",\n  \"email\": \"hello@moover.test\",\n  \"phone\": \"+8801700000000\",\n  \"address\": \"Dhaka, Bangladesh\",\n  \"timezone\": \"Asia/Dhaka\",\n  \"url\": \"https://example.com\"\n}" }, "url": "{{base_url}}/company" } },
        { "name": "Get Company", "request": { "method": "GET", "url": "{{base_url}}/company" } },
        { "name": "Update Company", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+8801711111111\",\n  \"address\": \"Gulshan, Dhaka\"\n}" }, "url": "{{base_url}}/company/update" } },
        { "name": "Delete Company", "disabled": true, "request": { "method": "DELETE", "url": "{{base_url}}/company" } },
        { "name": "Get System Config", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/system-config" } },
        { "name": "Create System Config", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"platform_name\": \"Moover Test\",\n  \"service_zones\": [\"Dhaka\", \"Chattogram\"],\n  \"primary_brand_color\": \"#0F766E\",\n  \"secondary_brand_color\": \"#F59E0B\"\n}" }, "url": "{{base_url}}/system-config" } },
        { "name": "Update System Config", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"platform_name\": \"Moover Operations\",\n  \"service_zones\": [\"Dhaka\"]\n}" }, "url": "{{base_url}}/system-config/update" } }
      ]
    },
    {
      "name": "Vehicle Classes And Vehicles",
      "item": [
        { "name": "List Vehicle Classes", "request": { "method": "GET", "url": "{{base_url}}/vehicle-classes" } },
        { "name": "Create Vehicle Class", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Executive Sedan\",\n  \"description\": \"Comfortable city transport\"\n}" }, "url": "{{base_url}}/vehicle-classes" }, "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json().data; if (pm.response.code < 400 && data?.id) pm.collectionVariables.set('vehicle_class_id', data.id);"] } }] },
        { "name": "Get Vehicle Class", "request": { "method": "GET", "url": "{{base_url}}/vehicle-classes/{{vehicle_class_id}}" } },
        { "name": "Update Vehicle Class", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated city transport class\"\n}" }, "url": "{{base_url}}/vehicle-classes/update/{{vehicle_class_id}}" } },
        { "name": "Delete Vehicle Class", "disabled": true, "request": { "method": "DELETE", "url": "{{base_url}}/vehicle-classes/{{vehicle_class_id}}" } },
        { "name": "List Vehicles", "request": { "method": "GET", "url": "{{base_url}}/vehicles" } },
        { "name": "Create Vehicle", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"vehicle_class_id\": {{vehicle_class_id}},\n  \"name\": \"Toyota Premio\",\n  \"category\": \"Sedan\",\n  \"capacity\": 4,\n  \"luggage\": 3,\n  \"status\": \"active\",\n  \"plate_number\": \"DHAKA-TEST-001\",\n  \"color\": \"Black\",\n  \"model\": \"2024\"\n}" }, "url": "{{base_url}}/vehicles" }, "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json().data; if (pm.response.code < 400 && data?.id) pm.collectionVariables.set('vehicle_id', data.id);"] } }] },
        { "name": "Get Vehicle", "request": { "method": "GET", "url": "{{base_url}}/vehicles/{{vehicle_id}}" } },
        { "name": "Update Vehicle", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\",\n  \"color\": \"Silver\"\n}" }, "url": "{{base_url}}/vehicles/update/{{vehicle_id}}" } },
        { "name": "Delete Vehicle", "disabled": true, "request": { "method": "DELETE", "url": "{{base_url}}/vehicles/{{vehicle_id}}" } }
      ]
    },
    {
      "name": "Drivers",
