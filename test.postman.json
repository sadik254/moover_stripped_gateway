        { "name": "Delete Driver", "disabled": true, "request": { "method": "DELETE", "url": "{{base_url}}/drivers/{{driver_id}}" } },
        { "name": "Login Driver", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"driver@example.com\",\n  \"password\": \"DRIVER_PASSWORD_FROM_CREATE_RESPONSE\"\n}" }, "url": "{{base_url}}/driver/login" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code < 400 && pm.response.json().token) { pm.collectionVariables.set('token', pm.response.json().token); }"] } }] },
        { "name": "Driver Password Reset Code", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"driver@example.com\"\n}" }, "url": "{{base_url}}/driver/request-password-reset-code" } },
        { "name": "Reset Driver Password", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"driver@example.com\",\n  \"reset_code\": \"123456\",\n  \"new_password\": \"password123\",\n  \"new_password_confirmation\": \"password123\"\n}" }, "url": "{{base_url}}/driver/reset-password-with-code" } },
        { "name": "Driver Profile", "request": { "method": "GET", "url": "{{base_url}}/driver/me" } },
        { "name": "Driver Bookings", "request": { "method": "GET", "url": "{{base_url}}/driver/bookings?status=assigned&per_page=15" } },
        { "name": "Driver Update Booking Status", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"on_route\"\n}" }, "url": "{{base_url}}/driver/bookings/{{booking_id}}/status" } },
        { "name": "Driver Update Booking Location", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"latitude\": 23.8103,\n  \"longitude\": 90.4125,\n  \"heading\": 90,\n  \"speed\": 30,\n  \"accuracy\": 10\n}" }, "url": "{{base_url}}/driver/bookings/{{booking_id}}/location" } },
        { "name": "Driver Update Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"old_password\": \"password123\",\n  \"new_password\": \"newpassword123\",\n  \"new_password_confirmation\": \"newpassword123\"\n}" }, "url": "{{base_url}}/driver/update-password" } },
        { "name": "Logout Driver", "request": { "method": "POST", "url": "{{base_url}}/driver/logout" } }
      ]
