        { "name": "Update Affiliate Booking Status", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"affiliate_status\": \"assigned_driver\",\n  \"assigned_affiliate_driver_id\": {{affiliate_driver_id}},\n  \"affiliate_reference\": \"AFF-TEST-001\",\n  \"affiliate_notes\": \"Driver assigned\"\n}" }, "url": "{{base_url}}/affiliate/bookings/{{booking_id}}/status" } },
        { "name": "Update Affiliate Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"old_password\": \"password123\",\n  \"new_password\": \"newpassword123\",\n  \"new_password_confirmation\": \"newpassword123\"\n}" }, "url": "{{base_url}}/affiliate/update-password" } },
        { "name": "Logout Affiliate", "request": { "method": "POST", "url": "{{base_url}}/affiliate/logout" } }
      ]
    },
    {
      "name": "Affiliate Drivers",
      "item": [
        { "name": "List Affiliate Drivers", "request": { "method": "GET", "url": "{{base_url}}/affiliate/drivers?per_page=15&status=active" } },
        { "name": "Create Affiliate Driver", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Affiliate Driver\",\n  \"email\": \"affiliate.driver@example.com\",\n  \"phone\": \"+8801411111111\",\n  \"status\": \"active\",\n  \"license_number\": \"AFF-DL-001\",\n  \"license_expiry\": \"2028-12-31\",\n  \"notes\": \"Available for airport trips\"\n}" }, "url": "{{base_url}}/affiliate/drivers" }, "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json().data; if (pm.response.code < 400 && data?.id) pm.collectionVariables.set('affiliate_driver_id', data.id);"] } }] },
        { "name": "Get Affiliate Driver", "request": { "method": "GET", "url": "{{base_url}}/affiliate/drivers/{{affiliate_driver_id}}" } },
        { "name": "Update Affiliate Driver", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\",\n  \"notes\": \"Updated availability note\"\n}" }, "url": "{{base_url}}/affiliate/drivers/{{affiliate_driver_id}}/update" } },
        { "name": "Delete Affiliate Driver", "disabled": true, "request": { "method": "DELETE", "url": "{{base_url}}/affiliate/drivers/{{affiliate_driver_id}}" } }
      ]
    },
