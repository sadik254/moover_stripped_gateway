        { "name": "List Drivers", "request": { "method": "GET", "url": "{{base_url}}/drivers?per_page=15" } },
        { "name": "Driver Dashboard Summary", "request": { "method": "GET", "url": "{{base_url}}/drivers/dashboard-summary" } },
        { "name": "Export Drivers CSV", "request": { "method": "GET", "url": "{{base_url}}/drivers/export/csv" } },
