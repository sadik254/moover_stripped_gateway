      "name": "Broadcasting",
      "item": [
        { "name": "Authenticate Private Channel", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"socket_id\": \"1234.5678\",\n  \"channel_name\": \"private-booking.{{booking_id}}\"\n}" }, "url": "{{base_url}}/broadcasting/auth" } }
      ]
    }
